{
  "manifest_version": 3,
  "name": "Strava Street View",
  "version": "1.0.0",
  "description": "Lets you right click to open that location in Google Street View",
  "homepage_url": "https://github.com/tyleha/strava-streetview",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.strava.com/maps*"],
      "js": ["src/content.js"],
      "css": ["src/menu.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
